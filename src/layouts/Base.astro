---
import { COMING_SOON, GALLERY, MURALS, SITE } from '../consts';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  // Strips the header and footer for a standalone page (the coming-soon landing).
  bare?: boolean;
}

const { title, description = SITE.description, bare = false } = Astro.props;
const pageTitle = title ? `${title} — ${SITE.artist}` : SITE.artist;
const path = Astro.url.pathname;

// While the landing page sits on "/", the rest of the site is still reachable
// but unlisted: keep it out of search results and point the header at the
// gallery's temporary home.
const noindex = COMING_SOON && path !== '/';
const home = COMING_SOON ? '/preview/' : '/';

const nav = [
  { href: home, label: 'Installations' },
  { href: '/murals/', label: 'Murals' },
  { href: '/gallery/', label: 'Gallery' },
  { href: '/compositions/', label: 'Compositions' },
  { href: '/about/', label: 'About' },
  { href: '/cv/', label: 'CV' },
  { href: '/shop/', label: 'Shop' },
  { href: '/contact/', label: 'Contact' },
];

// A work's own page counts as belonging to whichever section it appears in.
const workSlug = path.startsWith('/work/') ? path.split('/')[2] : undefined;
const workGroup = workSlug
  ? MURALS.includes(workSlug)
    ? 'murals'
    : GALLERY.includes(workSlug)
      ? 'gallery'
      : 'installations'
  : undefined;

const isActive = (href: string) => {
  if (href === home) return path === home || workGroup === 'installations';
  if (href === '/murals/') return path.startsWith('/murals') || workGroup === 'murals';
  if (href === '/gallery/') return path.startsWith('/gallery') || workGroup === 'gallery';
  return path.startsWith(href);
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
  </head>
  <body class={bare ? 'bare' : undefined}>
    {!bare && (
      <header class="site-header">
        <a class="wordmark" href={home}>{SITE.artist}</a>
        <nav>
          {nav.map(({ href, label }) => (
            <a href={href} aria-current={isActive(href) ? 'page' : undefined}>{label}</a>
          ))}
        </nav>
      </header>
    )}

    <main>
      <slot />
    </main>

    {!bare && (
      <footer class="site-footer">
        <p>© {new Date().getFullYear()} {SITE.artist}</p>
        <p><a href={SITE.instagram} target="_blank" rel="noopener">Instagram</a></p>
      </footer>
    )}
  </body>
</html>
