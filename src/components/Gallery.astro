---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { GALLERY, MURALS } from '../consts';

interface Props {
  // Which group of work to show. Omit to show everything.
  only?: 'installations' | 'murals' | 'gallery';
}

const { only } = Astro.props;

const groupOf = (id: string) =>
  MURALS.includes(id) ? 'murals' : GALLERY.includes(id) ? 'gallery' : 'installations';

const artworks = (await getCollection('artworks'))
  .filter((work) => !only || groupOf(work.id) === only)
  .sort((a, b) => a.data.order - b.data.order || b.data.year - a.data.year);
---

{artworks.length === 0 ? (
  <p class="gallery-empty">Work for this section is on its way.</p>
) : (
  <ul class="gallery">
    {artworks.map((work) => (
      <li>
        <a href={`/work/${work.id}/`}>
          <Image
            src={work.data.cover}
            alt={`${work.data.title}, ${work.data.year}`}
            widths={[400, 800, 1200]}
            sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
          />
          <p class="caption">{work.data.title}, {work.data.year}</p>
        </a>
      </li>
    ))}
  </ul>
)}
