---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { CONCEPTUAL, MURALS, PAINTINGS } from '../consts';

interface Props {
  // Which group of work to show. Omit to show everything.
  only?: 'installations' | 'murals' | 'paintings' | 'conceptual';
}

const { only } = Astro.props;

const groupOf = (id: string) =>
  MURALS.includes(id)
    ? 'murals'
    : PAINTINGS.includes(id)
      ? 'paintings'
      : CONCEPTUAL.includes(id)
        ? 'conceptual'
        : 'installations';

const artworks = (await getCollection('artworks'))
  .filter((work) => !only || groupOf(work.id) === only)
  .sort((a, b) => a.data.order - b.data.order || b.data.year - a.data.year);

// A work can supply its own square tile as thumb.jpg in its folder, for when a
// crop reads better small than the cover does. Without one, the cover is used.
const thumbs = import.meta.glob<ImageMetadata>(
  '/src/content/artworks/*/thumb.{jpg,jpeg,png,webp}',
  { eager: true, import: 'default' },
);
const tileOf = (work: (typeof artworks)[number]) =>
  Object.entries(thumbs).find(([path]) =>
    path.startsWith(`/src/content/artworks/${work.id}/thumb.`),
  )?.[1] ?? work.data.cover;
---

{artworks.length === 0 ? (
  <p class="gallery-empty">Work for this section is on its way.</p>
) : (
  <ul class="gallery">
    {artworks.map((work) => (
      <li>
        <a href={`/work/${work.id}/`}>
          <Image
            src={tileOf(work)}
            alt={`${work.data.title}, ${work.data.year}`}
            widths={[400, 800, 1200]}
            sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
          />
          <p class="caption">{work.data.title}, {work.data.year}</p>
        </a>
      </li>
    ))}
  </ul>
)}
