---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { MURALS } from '../consts';

interface Props {
  // Which half of the work to show. Omit to show everything.
  only?: 'installations' | 'murals';
}

const { only } = Astro.props;

const artworks = (await getCollection('artworks'))
  .filter((work) => {
    if (!only) return true;
    const isMural = MURALS.includes(work.id);
    return only === 'murals' ? isMural : !isMural;
  })
  .sort((a, b) => a.data.order - b.data.order || b.data.year - a.data.year);
---

<ul class="gallery">
  {artworks.map((work) => (
    <li>
      <a href={`/work/${work.id}/`}>
        <Image
          src={work.data.cover}
          alt={`${work.data.title}, ${work.data.year}`}
          widths={[400, 800, 1200]}
          sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
        />
        <p class="caption">{work.data.title}, {work.data.year}</p>
      </a>
    </li>
  ))}
</ul>
