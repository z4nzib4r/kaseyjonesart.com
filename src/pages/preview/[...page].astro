---
import { COMING_SOON } from '../../consts';
import Base from '../../layouts/Base.astro';
import Gallery from '../../components/Gallery.astro';

// Unlisted preview of the gallery, so the site is still viewable while the
// coming-soon landing sits on "/". Returning no paths when COMING_SOON is
// false means this route stops being built at all once the site relaunches.
export function getStaticPaths() {
  return COMING_SOON ? [{ params: { page: undefined } }] : [];
}
---

<Base title="Preview">
  <Gallery />
</Base>
