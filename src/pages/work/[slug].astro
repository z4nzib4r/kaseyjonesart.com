---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const artworks = await getCollection('artworks');
  return artworks.map((work) => ({
    params: { slug: work.id },
    props: { work },
  }));
}

const { work } = Astro.props;
const { Content } = await render(work);
const { title, year, materials, dimensions, location } = work.data;
const meta = [year, materials, dimensions, location].filter(Boolean).join(' · ');
---

<Base title={title} description={`${title} (${year}) — ${materials ?? 'work'} by Kasey Jones.`}>
  <article class="article">
    <a class="back-link" href="/">← All work</a>
    <header class="article-header">
      <h1>{title}</h1>
      <p class="meta">{meta}</p>
    </header>
    <Image
      class="cover"
      src={work.data.cover}
      alt={`${title}, ${year}`}
      widths={[800, 1200, 1800]}
      sizes="(max-width: 860px) 100vw, 820px"
    />
    <div class="article-body">
      <Content />
    </div>
  </article>
</Base>
